<MudDialog Class="portfolio-dialog">
    <TitleContent>
        <MudText Typo="Typo.h6">Meus contatos</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1" Class="mb-4">
            Fique à vontade para entrar em contato para oportunidades, colaborações ou networking.
        </MudText>
        <div class="channels">
            @foreach (var channel in Profile.Channels)
            {
                <a class="channel" href="@channel.Url" target="_blank" rel="noopener">
                    <MudIcon Icon="@IconFor(channel.Label)" Size="Size.Large" Color="@ColorFor(channel.Label)" />
                    <span class="channel__label">@channel.Label</span>
                    <span class="channel__value">@channel.Value</span>
                </a>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => Dialog.Close()">Fechar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    private static string IconFor(string label) => label switch
    {
        "GitHub" => Icons.Custom.Brands.GitHub,
        "LinkedIn" => Icons.Custom.Brands.LinkedIn,
        "WhatsApp" => Icons.Custom.Brands.WhatsApp,
        _ => Icons.Material.Filled.Email
    };

    private static Color ColorFor(string label) => label switch
    {
        "GitHub" => Color.Primary,
        "LinkedIn" => Color.Info,
        "WhatsApp" => Color.Success,
        _ => Color.Warning
    };
}
