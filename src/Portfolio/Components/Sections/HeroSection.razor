<div class="hero">
    <div class="hero__avatar">
        <MudImage Src="@Profile.Avatar" Alt="Avatar de João Marcelo" Width="150" Height="225" Class="hero__avatar-image" />
    </div>

    <div class="hero__bio">
        <MudText Typo="Typo.h4">@Profile.Name</MudText>
        <MudText Typo="Typo.subtitle1" Class="hero__role">@Profile.Role · @Profile.Location</MudText>
        <MudDivider Class="my-3" />
        <MudText Typo="Typo.body1" Class="hero__headline">@Profile.Headline</MudText>
        <MudText Typo="Typo.body2" Class="hero__intro">@Profile.Introduction</MudText>

        <div class="hero__actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="#projetos" StartIcon="@Icons.Material.Filled.SettingsSystemDaydream">
                Ver projetos
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="@Profile.Resume" StartIcon="@Icons.Material.Filled.Download"
                       UserAttributes="@DownloadAttributes">
                Baixar currículo
            </MudButton>
            <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Href="@Profile.GitHub" Target="_blank" aria-label="GitHub" Class="hero__social" />
            <MudIconButton Icon="@Icons.Custom.Brands.LinkedIn" Href="@Profile.LinkedIn" Target="_blank" aria-label="LinkedIn" Class="hero__social" />
        </div>
    </div>
</div>

<MudDivider Class="my-6" />

<MudGrid Spacing="3" Justify="Justify.Center">
    @foreach (var area in Expertise.Areas)
    {
        <MudItem xs="12" sm="6" md="4">
            <div class="skill glass-soft lift">
                <MudIcon Icon="@area.Icon" Size="Size.Large" Class="skill__icon" />
                <MudText Typo="Typo.h6" Class="skill__title">@area.Title</MudText>
                <MudText Typo="Typo.body2" Class="skill__description">@area.Description</MudText>
                <TechChips Items="area.Technologies" Class="skill__chips" />
            </div>
        </MudItem>
    }
</MudGrid>

@code {
    private static readonly Dictionary<string, object> DownloadAttributes = new() { ["download"] = "Curriculo-Joao-Marcelo-Daltro-Marques.pdf" };
}
