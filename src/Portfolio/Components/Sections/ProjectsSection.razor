@inject IDialogService DialogService

<SectionTitle Title="Projetos" Subtitle="Projetos autorais e entregas profissionais em destaque." />

<MudGrid Spacing="3">
    @foreach (var project in Projects.Featured)
    {
        <MudItem xs="12" sm="6" lg="4">
            <article class="project glass lift">
                @if (project.Image is not null)
                {
                    <img class="project__image" src="@project.Image" alt="@project.ImageAlt" loading="lazy" />
                }
                else
                {
                    <div class="project__cover">
                        <MudIcon Icon="@(project.CoverIcon ?? Icons.Material.Filled.Code)" Class="project__cover-icon" />
                    </div>
                }

                <div class="project__body">
                    <div class="project__meta">
                        <MudText Typo="Typo.caption" Class="project__context">@project.Context</MudText>
                        <StatusChip Status="project.Status" />
                    </div>
                    <MudText Typo="Typo.h6">@project.Name</MudText>
                    <MudText Typo="Typo.body2" Class="project__summary">@project.Summary</MudText>
                    <TechChips Items="project.Stack" Limit="5" />
                </div>

                <div class="project__actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Info"
                               OnClick="() => OpenAsync(project)">
                        Detalhes
                    </MudButton>
                    @foreach (var link in project.Links.Take(2))
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" Href="@link.Url" Target="_blank"
                                   StartIcon="@(link.Url.Contains("github.com") ? Icons.Custom.Brands.GitHub : Icons.Material.Filled.Launch)">
                            @link.Label
                        </MudButton>
                    }
                </div>
            </article>
        </MudItem>
    }
</MudGrid>

@code {
    private Task OpenAsync(FeaturedProject project)
    {
        var parameters = new DialogParameters<ProjectDialog> { { x => x.Project, project } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true };
        return DialogService.ShowAsync<ProjectDialog>(project.Name, parameters, options);
    }
}
