<section id="especialidades" class="section">
    <div class="container">
        <SectionHeader Index="01" Label="Especialidades" Title="Do banco de dados ao mapa"
                       Description="Áreas em que atuo no dia a dia, com as tecnologias que uso em cada uma." />

        <ol class="areas">
            @foreach (var (area, index) in Expertise.Areas.Select((area, index) => (area, index)))
            {
                <li class="area" data-reveal>
                    <span class="area__index mono">@((index + 1).ToString("00"))</span>
                    <h3 class="area__title">@area.Title</h3>
                    <p class="area__description">@area.Description</p>
                    <StackList Items="area.Technologies" />
                </li>
            }
        </ol>
    </div>
</section>
